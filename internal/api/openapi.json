        "schema": {
         "$ref": "#/components/schemas/ResolveReply"
        }
       }
      }
     },
     "404": {
      "description": "No such task, suggestion or route.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "409": {
      "description": "The suggestion is stale (its task changed since) or was already resolved.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
