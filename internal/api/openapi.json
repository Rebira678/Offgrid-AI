 "components": {
  "schemas": {
   "Error": {
    "type": "object",
    "properties": {
     "code": {
      "type": "string",
      "enum": [
       "bad_request",
       "invalid",
       "not_found",
       "stale",
       "already_resolved",
       "too_large",
       "unsupported_media_type",
       "method_not_allowed",
       "internal",
       "forbidden",
       "missing_header",
       "bad_host",
       "cross_origin",
       "cross_site",
       "unpaired",
       "slow_down",
       "empty"
      ]
     },
     "message": {
      "type": "string"
     }
    },
    "additionalProperties": false,
    "required": [
     "code",
     "message"
    ]
   },
   "Note": {
    "type": "object",
    "properties": {
     "text": {
      "type": "string"
     },
     "at": {
      "type": "string",
      "format": "date-time"
     }
    },
    "additionalProperties": false,
    "required": [
     "text",
     "at"
    ]
   },
   "Task": {
    "type": "object",
    "properties": {
     "id": {
      "type": "string"
     },
     "title": {
      "type": "string"
     },
     "site": {
      "type": "string"
     },
     "status": {
      "type": "string",
      "enum": [
       "open",
       "in_progress",
       "done"
      ]
     },
     "priority": {
      "type": "string",
      "enum": [
       "low",
       "medium",
       "high"
