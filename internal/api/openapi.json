  "/v1/suggestions/{id}/accept": {
   "post": {
    "summary": "Accept a suggestion: apply it to its task. Refused (stale) if the task changed since.",
    "tags": [
     "suggestions"
    ],
    "x-stability": "stable",
    "responses": {
     "200": {
      "description": "The changed task.",
      "content": {
