{
 "openapi": "3.0.3",
 "info": {
  "title": "Offgrid API",
  "version": "1.0.0",
  "description": "The contract for scripts, the phone app and a future native app. Everything under /v1 is stable: it only grows. Anything under /v0 is not yet proven and may change; webhook events (the Event schema) are v0. Unknown routes answer 404 not_found and wrong methods 405 method_not_allowed, with the Error body. Every POST and PATCH must carry the header X-Offgrid-Action: 1. The local API listens on this machine only; a paired phone reaches the same routes with its session cookie. See docs/api/versioning.md."
 },
 "servers": [
  {
   "url": "http://127.0.0.1:8090"
  }
 ],
 "tags": [
  {
   "name": "meta"
  },
  {
   "name": "tasks"
  },
  {
   "name": "attachments"
  },
  {
   "name": "suggestions"
  },
  {
   "name": "csv"
  }
 ],
 "paths": {
  "/v1/info": {
   "get": {
    "summary": "Node and API version.",
    "tags": [
     "meta"
    ],
    "x-stability": "stable",
    "responses": {
     "200": {
      "description": "OK",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Info"
        }
       }
      }
     },
     "500": {
      "description": "The node could not complete the request.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    }
   }
  },
  "/v1/openapi.json": {
   "get": {
    "summary": "This contract.",
    "tags": [
     "meta"
    ],
    "x-stability": "stable",
    "responses": {
     "200": {
      "description": "The OpenAPI document.",
      "content": {
       "application/json": {
        "schema": {
         "type": "object",
         "additionalProperties": true
        }
       }
      }
     }
    }
   }
  },
  "/v1/tasks": {
   "get": {
    "summary": "List tasks, oldest first, a page at a time.",
    "tags": [
     "tasks"
    ],
    "x-stability": "stable",
    "responses": {
     "200": {
      "description": "A page.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/TaskList"
        }
       }
      }
     },
     "400": {
      "description": "The request could not be read (bad JSON, unknown field, bad query value).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "500": {
      "description": "The node could not complete the request.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "parameters": [
     {
      "name": "status",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "open",
        "in_progress",
        "done"
       ]
      }
     },
     {
      "name": "priority",
      "in": "query",
      "schema": {
       "type": "string",
       "enum": [
        "low",
        "medium",
        "high"
       ]
      }
     },
     {
      "name": "site",
      "in": "query",
      "schema": {
       "type": "string"
      }
     },
     {
      "name": "limit",
      "in": "query",
      "schema": {
       "type": "integer",
       "minimum": 1,
       "maximum": 500,
       "default": 100
      }
     },
     {
      "name": "cursor",
      "in": "query",
      "description": "The next_cursor of the previous page. Opaque.",
      "schema": {
       "type": "string"
      }
     }
    ]
   },
   "post": {
    "summary": "Create a task. If an unfinished task with the same title and site exists, nothing is made and that task comes back with created false.",
    "tags": [
     "tasks"
    ],
    "x-stability": "stable",
    "responses": {
     "200": {
      "description": "Already there.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CreateReply"
        }
       }
      }
     },
     "201": {
      "description": "Created.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/CreateReply"
        }
       }
      }
     },
     "400": {
      "description": "The request could not be read (bad JSON, unknown field, bad query value).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "413": {
      "description": "Over a size limit.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "422": {
      "description": "Read, but not acceptable (an empty title, an unknown status...).",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     },
     "500": {
      "description": "The node could not complete the request.",
      "content": {
       "application/json": {
        "schema": {
         "$ref": "#/components/schemas/Error"
        }
       }
      }
     }
    },
    "requestBody": {
     "required": true,
     "content": {
      "application/json": {
       "schema": {
        "$ref": "#/components/schemas/CreateRequest"
       }
      }
     }
    }
   }
  },
